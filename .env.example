# Copy to .env before starting the Compose stacks. Never commit the real file.

# ---- Datastores (deploy/datastores) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=surface_volume
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# ---- Backend ----
PORT=8080
BACKEND_HOST_PORT=8080
WEB_HOST_PORT=4321
PUBLIC_BACKEND_URL=http://localhost:8080
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/surface_volume?schema=public"
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET="change-me-to-a-long-random-value"
JWT_EXPIRES_IN=1d
APP_URL=http://localhost:8080
INTERNAL_SERVICE_TOKEN=change-me
# 32 random bytes, base64: openssl rand -base64 32
CONNECTION_KEY=
CONNECTION_KEY_VERSION=1

# ---- Runner ----
RUNNER_REPLICAS=3
RUST_LOG=info

# ---- Telemetry (shared external network by default) ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SAMPLING_RATIO=1
OTEL_LOG_LEVEL=info

# ---- Grafana ----
GF_SECURITY_ADMIN_PASSWORD=admin
