---
import Base from './Base.astro'
import { ACCOUNT, SERVICES } from '../data/mock'

interface Props { title?: string; active?: string }
const { title = 'area', active = '' } = Astro.props

const primary = [
  { to: '/', label: 'Workflows', icon: 'grid' },
  { to: '/runs', label: 'Runs', icon: 'activity' },
  { to: '/services', label: 'Services', icon: 'bolt' },
]
const secondary = [
  { to: '/android', label: 'Android client', icon: 'phone' },
  { to: '/settings', label: 'Settings', icon: 'sliders' },
]
const connected = SERVICES.filter((service) => service.state !== 'none').slice(0, 5)
const isActive = (to: string) => (to === '/' ? active === '' || active === 'workflows' : active === to.slice(1))
---
<Base title={title}>
  <div class="h-screen">
    <a href="#main" class="skip">Skip to main content</a>
    <div class="flex h-full">
      <aside class="hidden w-[248px] shrink-0 flex-col gap-0.5 overflow-hidden border-r border-line bg-side p-3 lg:flex">
        <div class="flex items-center gap-2.5 px-1 pb-3 pt-2">
          <a href="/" class="text-[19px] font-semibold tracking-tight">area<span class="text-accent">.</span></a>
        </div>
        <div class="px-2.5 pb-1 text-[10.5px] font-semibold uppercase tracking-[.09em] text-faint">Automation</div>
        <nav aria-label="Automation" class="flex flex-col gap-0.5">
          {primary.map((item) => (
            <a href={item.to} class:list={['flex items-center gap-2.5 rounded-lg px-2.5 py-[7px] text-[13.5px]', isActive(item.to) ? 'bg-fill font-semibold text-ink' : 'text-mute hover:bg-fill hover:text-ink']}>
              <span class="text-[15px]" aria-hidden="true">{item.icon === 'grid' ? '▦' : item.icon === 'activity' ? '⌁' : '⚡'}</span>
              <span class="truncate">{item.label}</span>
            </a>
          ))}
        </nav>
        <div class="mt-4 px-2.5 pb-1 text-[10.5px] font-semibold uppercase tracking-[.09em] text-faint">Workspace</div>
        <nav aria-label="Workspace" class="flex flex-col gap-0.5">
          {secondary.map((item) => (
            <a href={item.to} class:list={['flex items-center gap-2.5 rounded-lg px-2.5 py-[7px] text-[13.5px]', isActive(item.to) ? 'bg-fill font-semibold text-ink' : 'text-mute hover:bg-fill hover:text-ink']}>
              <span class="truncate">{item.label}</span>
            </a>
          ))}
        </nav>
        <div class="mt-5">
          <div class="mb-1.5 flex items-center justify-between px-2">
            <span class="text-[10.5px] font-semibold uppercase tracking-[.09em] text-faint">Connected services</span>
            <a href="/services" class="text-[11px] text-mute hover:text-ink">Manage</a>
          </div>
          <div class="space-y-0.5">
            {connected.map((service) => (
              <a href={`/services?service=${service.id}`} class="flex items-center gap-2 rounded-lg px-2 py-[5px] text-[12.5px] text-mute hover:bg-fill">
                <span class="h-3 w-3 rounded" style={`background:${service.color}`} aria-hidden="true"></span>
                <span class="truncate">{service.name}</span>
              </a>
            ))}
          </div>
        </div>
        <div class="mt-auto flex items-center gap-2.5 rounded-xl p-2">
          <span class="grid h-8 w-8 place-items-center rounded-full bg-accent-soft text-[12px] font-semibold text-accent">{ACCOUNT.initials}</span>
          <span class="min-w-0 flex-1">
            <span class="block truncate text-[12.5px] font-semibold">{ACCOUNT.name}</span>
            <span class="block truncate text-[11px] text-mute">{ACCOUNT.email}</span>
          </span>
          <a href="/api/auth/signout" class="btn btn-ghost btn-sm" title="Sign out">Sign out</a>
        </div>
      </aside>
      <main id="main" tabIndex={-1} class="flex h-screen min-w-0 flex-1 flex-col overflow-hidden">
        <nav class="flex gap-1 border-b border-line bg-card px-4 py-2 text-[12px] lg:hidden">
          {[...primary, ...secondary].map((item) => (
            <a href={item.to} class="rounded-lg px-2 py-1 text-mute hover:bg-fill">{item.label}</a>
          ))}
        </nav>
        <div class="min-h-0 flex-1 overflow-hidden">
          <slot />
        </div>
      </main>
    </div>
  </div>
</Base>
