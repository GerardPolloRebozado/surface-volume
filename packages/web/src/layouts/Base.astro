---
import '../index.css'
interface Props { title?: string }
const { title = 'area · the workflow is the page' } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
  </head>
  <body class="bg-win text-ink">
    <slot />
  </body>
</html>
