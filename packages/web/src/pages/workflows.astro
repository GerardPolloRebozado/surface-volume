---
import App from '../layouts/App.astro'
import { WorkflowsRoute } from '../routes/Workflows'
import { ACCESS_COOKIE, BACKEND_URL } from '../lib/auth'
import { fetchWorkflows } from '../lib/workflows'

const token = Astro.cookies.get(ACCESS_COOKIE)?.value ?? ''
const workflows = await fetchWorkflows(token, BACKEND_URL).catch(() => [])
---
<App title="Workflows · area" active="workflows">
  <WorkflowsRoute client:load workflows={workflows} />
</App>
