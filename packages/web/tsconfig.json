{
  "extends": "astro/tsconfigs/base",
  "include": ["src/**/*", ".astro/types.d.ts"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@contract/*": ["../contract/*"],
      "@api-client/*": ["../api-client-ts/*"]
    },
    "types": ["astro/client", "node"]
  }
}